# ===== 绝对不能提交（隐私 / 密钥）=====
识别配置.txt
*.key
.env

# ===== 真实学生数据（隐私，绝对不能提交）=====
# 姓名 / 分数 / 错题号
班级名单/
成绩表/
# 答题卡照片（新旧两种目录名都挡）
答题卡照片/
照片/
# 生成出来的产物：话术 / 报告 / 巩固单 / 群发文件
生成结果/
群发/
# 每讲练的题库（按班级分目录，含班级名）
题目/
# 答案文件（含考点，属于内部资料）
课测答案/
# 历史归档
_旧数据_*/

# ===== 运行环境 =====
程序/python/
程序/web/__pycache__/
__pycache__/
*.pyc

# ===== 临时产物 =====
*.bak
*.log
~$*
_tmp_*
# 抄别人代码前的备份目录
程序/脚本/_抄之前备份/

# ===== 打包产物 =====
*.zip

# ===== 演示/会话产物 =====
.DS_Store
Thumbs.db
